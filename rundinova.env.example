# RundiNova Tech ERP deployment profile.
# Copy to a private environment file before use. Never commit the copy.

ERPNEXT_VERSION=v16.37.7
CUSTOM_IMAGE=rundinova/erpnext
# Build, load, or explicitly pull the release image before starting Compose.
# Replace this value with the exact release tag selected for the deployment.
CUSTOM_TAG=replace-with-a-built-rundinova-image-tag
PULL_POLICY=never

# Use a long random value in production.
DB_PASSWORD=replace-with-a-long-random-password

HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
NGINX_LISTEN_PORT=8080

# The ERP site is separate from the public static website.
NGINX_PROXY_HOSTS=erp.rundinova.com
LETSENCRYPT_EMAIL=operations@rundinova.com

# Optional local backup service (include overrides/compose.backup-cron.yaml).
# Backups stay in the Docker sites volume until copied off-host.
BACKUP_INTERVAL_SECONDS=21600

# Keep this stack ready for additional sites later. Add hostnames as a
# comma-separated list after creating and configuring those sites.
# Example: erp.rundinova.com,hr.rundinova.com,crm.rundinova.com
