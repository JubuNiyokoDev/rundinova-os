{
  "doctype": "DocType",
  "name": "RundiNova Repository",
  "module": "RundiNova Tech",
  "custom": 0,
  "title_field": "repository_name",
  "show_title_field_in_link": 1,
  "fields": [
    {
      "fieldname": "repository_name",
      "fieldtype": "Data",
      "label": "Repository Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "github_url",
      "fieldtype": "Data",
      "label": "GitHub URL",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "repository_type",
      "fieldtype": "Select",
      "label": "Type",
      "options": "Product\nApplication\nWebsite\nInfrastructure\nLibrary\nOther",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Planned\nActive\nPaused\nArchived",
      "default": "Active",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "primary_owner",
      "fieldtype": "Link",
      "options": "User",
      "label": "Primary Owner"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "options": "Project",
      "label": "Project"
    },
    {
      "fieldname": "column_break_basic",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "project_stage",
      "fieldtype": "Select",
      "label": "Project Stage",
      "options": "Idea\nDiscovery\nPlanning\nDevelopment\nTesting\nDeployment\nMaintenance\nRetired",
      "default": "Planning"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "Priority",
      "options": "Critical\nHigh\nMedium\nLow"
    },
    {
      "fieldname": "progress_percent",
      "fieldtype": "Percent",
      "label": "Progress %",
      "default": "0"
    },
    {
      "fieldname": "business_value",
      "fieldtype": "Currency",
      "label": "Business Value (FBu)"
    },
    {
      "fieldname": "section_timeline",
      "fieldtype": "Section Break",
      "label": "Timeline"
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date"
    },
    {
      "fieldname": "target_end_date",
      "fieldtype": "Date",
      "label": "Target End Date"
    },
    {
      "fieldname": "actual_end_date",
      "fieldtype": "Date",
      "label": "Actual End Date",
      "read_only": 1
    },
    {
      "fieldname": "column_break_timeline",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "estimated_hours",
      "fieldtype": "Float",
      "label": "Estimated Hours"
    },
    {
      "fieldname": "actual_hours",
      "fieldtype": "Float",
      "label": "Actual Hours",
      "read_only": 1
    },
    {
      "fieldname": "tasks_count",
      "fieldtype": "Int",
      "label": "Total Tasks",
      "read_only": 1
    },
    {
      "fieldname": "completed_tasks_count",
      "fieldtype": "Int",
      "label": "Completed Tasks",
      "read_only": 1
    },
    {
      "fieldname": "section_metrics",
      "fieldtype": "Section Break",
      "label": "Metrics"
    },
    {
      "fieldname": "impact_summary",
      "fieldtype": "Small Text",
      "label": "Impact Summary"
    },
    {
      "fieldname": "tech_stack",
      "fieldtype": "Small Text",
      "label": "Tech Stack"
    },
    {
      "fieldname": "column_break_metrics",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "risk_level",
      "fieldtype": "Select",
      "label": "Risk Level",
      "options": "Low\nMedium\nHigh\nCritical"
    },
    {
      "fieldname": "dependencies",
      "fieldtype": "Small Text",
      "label": "Dependencies"
    },
    {
      "fieldname": "last_reviewed_on",
      "fieldtype": "Date",
      "label": "Last Reviewed"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Long Text",
      "label": "Notes"
    },
    {
      "fieldname": "github_section",
      "fieldtype": "Section Break",
      "label": "GitHub Sync"
    },
    {
      "fieldname": "open_issues_count",
      "fieldtype": "Int",
      "label": "Open Issues",
      "read_only": 1
    },
    {
      "fieldname": "stargazers_count",
      "fieldtype": "Int",
      "label": "Stars",
      "read_only": 1
    },
    {
      "fieldname": "forks_count",
      "fieldtype": "Int",
      "label": "Forks",
      "read_only": 1
    },
    {
      "fieldname": "default_branch",
      "fieldtype": "Data",
      "label": "Default Branch",
      "read_only": 1
    },
    {
      "fieldname": "primary_language",
      "fieldtype": "Data",
      "label": "Primary Language",
      "read_only": 1
    },
    {
      "fieldname": "last_synced_on",
      "fieldtype": "Datetime",
      "label": "Last Synced",
      "read_only": 1
    },
    {
      "fieldname": "column_break_sync",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "last_push_date",
      "fieldtype": "Datetime",
      "label": "Last Push",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "RundiNova Director",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "RundiNova Finance Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "RundiNova Operations",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "RundiNova Project Lead",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "RundiNova Team Member",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "RundiNova Communications",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "RundiNova People & Culture",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
