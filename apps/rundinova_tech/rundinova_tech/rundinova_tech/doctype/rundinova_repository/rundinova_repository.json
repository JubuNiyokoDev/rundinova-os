{
  "doctype": "DocType",
  "name": "RundiNova Repository",
  "module": "RundiNova Tech",
  "custom": 0,
  "title_field": "repository_name",
  "fields": [
    {"fieldname": "repository_name", "fieldtype": "Data", "label": "Repository Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "github_url", "fieldtype": "Data", "label": "GitHub URL", "reqd": 1, "in_list_view": 1},
    {"fieldname": "repository_type", "fieldtype": "Select", "label": "Type", "options": "Product\nApplication\nWebsite\nInfrastructure\nLibrary\nOther", "reqd": 1, "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Planned\nActive\nPaused\nArchived", "default": "Active", "reqd": 1, "in_list_view": 1},
    {"fieldname": "primary_owner", "fieldtype": "Link", "options": "User", "label": "Primary Owner"},
    {"fieldname": "project", "fieldtype": "Link", "options": "Project", "label": "Project"},
    {"fieldname": "progress_percent", "fieldtype": "Percent", "label": "Progress %", "default": "0"},
    {"fieldname": "business_value", "fieldtype": "Currency", "label": "Business Value (BIF)"},
    {"fieldname": "impact_summary", "fieldtype": "Small Text", "label": "Impact Summary"},
    {"fieldname": "last_reviewed_on", "fieldtype": "Date", "label": "Last Reviewed"},
    {"fieldname": "notes", "fieldtype": "Long Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "RundiNova Director", "read": 1, "write": 1, "create": 1},
    {"role": "RundiNova Project Lead", "read": 1, "write": 1, "create": 1},
    {"role": "RundiNova Team Member", "read": 1},
    {"role": "RundiNova Communications", "read": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
