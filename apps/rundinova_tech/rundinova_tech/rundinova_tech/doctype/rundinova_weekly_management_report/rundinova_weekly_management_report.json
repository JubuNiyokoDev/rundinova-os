{
  "doctype": "DocType",
  "name": "RundiNova Weekly Management Report",
  "module": "RundiNova Tech",
  "custom": 0,
  "title_field": "report_title",
  "show_title_field_in_link": 1,
  "track_changes": 1,
  "sort_field": "report_date",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "report_title", "fieldtype": "Data", "label": "Rapport", "reqd": 1, "in_list_view": 1},
    {"fieldname": "report_type", "fieldtype": "Select", "label": "Fonction", "options": "Opérations\nFinances et administration", "reqd": 1, "in_list_view": 1},
    {"fieldname": "responsible", "fieldtype": "Link", "options": "User", "label": "Responsable", "reqd": 1, "in_list_view": 1},
    {"fieldname": "report_date", "fieldtype": "Date", "label": "Date du rapport", "reqd": 1, "in_list_view": 1},
    {"fieldname": "period_start", "fieldtype": "Date", "label": "Début de période", "reqd": 1},
    {"fieldname": "period_end", "fieldtype": "Date", "label": "Fin de période", "reqd": 1},
    {"fieldname": "submission_deadline", "fieldtype": "Datetime", "label": "Échéance de transmission (CAT)", "reqd": 1},
    {"fieldname": "related_meeting", "fieldtype": "Link", "options": "RundiNova Governance Meeting", "label": "Réunion de direction liée"},
    {"fieldname": "section_content", "fieldtype": "Section Break", "label": "Contenu du rapport"},
    {"fieldname": "achievements", "fieldtype": "Long Text", "label": "Réalisations"},
    {"fieldname": "indicators_evidence", "fieldtype": "Long Text", "label": "Indicateurs et preuves"},
    {"fieldname": "pending_items", "fieldtype": "Long Text", "label": "Éléments en attente et motifs"},
    {"fieldname": "risks_blockers", "fieldtype": "Long Text", "label": "Risques et blocages"},
    {"fieldname": "next_priorities", "fieldtype": "Long Text", "label": "Priorités de la semaine suivante"},
    {"fieldname": "validations_required", "fieldtype": "Long Text", "label": "Validations requises"},
    {"fieldname": "evidence", "fieldtype": "Attach", "label": "Document / preuve"},
    {"fieldname": "section_review", "fieldtype": "Section Break", "label": "Revue de direction"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Statut", "options": "À préparer\nTransmis\nExaminé\nÀ corriger", "default": "À préparer", "reqd": 1, "in_list_view": 1},
    {"fieldname": "reviewed_by", "fieldtype": "Link", "options": "User", "label": "Examiné par"},
    {"fieldname": "reviewed_on", "fieldtype": "Datetime", "label": "Date de revue"},
    {"fieldname": "review_notes", "fieldtype": "Small Text", "label": "Commentaires de revue"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
