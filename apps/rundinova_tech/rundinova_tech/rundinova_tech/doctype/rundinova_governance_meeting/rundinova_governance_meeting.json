{
  "doctype": "DocType",
  "name": "RundiNova Governance Meeting",
  "module": "RundiNova Tech",
  "custom": 0,
  "title_field": "meeting_title",
  "show_title_field_in_link": 1,
  "track_changes": 1,
  "sort_field": "meeting_date",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "meeting_title", "fieldtype": "Data", "label": "Réunion", "reqd": 1, "in_list_view": 1},
    {"fieldname": "meeting_type", "fieldtype": "Select", "label": "Type", "options": "Réunion hebdomadaire de direction\nRéunion mensuelle de toute l’équipe\nBilan trimestriel", "reqd": 1, "in_list_view": 1},
    {"fieldname": "meeting_date", "fieldtype": "Date", "label": "Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "start_time", "fieldtype": "Time", "label": "Début (CAT)", "reqd": 1},
    {"fieldname": "end_time", "fieldtype": "Time", "label": "Fin (CAT)", "reqd": 1},
    {"fieldname": "chair", "fieldtype": "Link", "options": "User", "label": "Présidence", "reqd": 1},
    {"fieldname": "secretary", "fieldtype": "Link", "options": "User", "label": "Secrétariat", "reqd": 1},
    {"fieldname": "attendees", "fieldtype": "Small Text", "label": "Participants"},
    {"fieldname": "section_agenda", "fieldtype": "Section Break", "label": "Préparation et procès-verbal"},
    {"fieldname": "agenda", "fieldtype": "Long Text", "label": "Ordre du jour"},
    {"fieldname": "summary", "fieldtype": "Long Text", "label": "Synthèse des échanges"},
    {"fieldname": "decisions_summary", "fieldtype": "Long Text", "label": "Décisions prises"},
    {"fieldname": "minutes_file", "fieldtype": "Attach", "label": "Procès-verbal signé"},
    {"fieldname": "minutes_status", "fieldtype": "Select", "label": "Statut du procès-verbal", "options": "À préparer\nBrouillon\nDiffusé", "default": "À préparer", "in_list_view": 1},
    {"fieldname": "next_meeting_date", "fieldtype": "Date", "label": "Prochaine réunion"},
    {"fieldname": "section_actions", "fieldtype": "Section Break", "label": "Actions décidées"},
    {"fieldname": "actions", "fieldtype": "Table", "options": "RundiNova Meeting Action", "label": "Actions liées"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Statut", "options": "Planifiée\nTenue\nAnnulée", "default": "Planifiée", "reqd": 1, "in_list_view": 1}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
