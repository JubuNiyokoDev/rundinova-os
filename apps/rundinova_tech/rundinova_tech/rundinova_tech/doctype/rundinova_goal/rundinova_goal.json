    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"fieldname": "owner", "fieldtype": "Link", "options": "User", "label": "Owner", "reqd": 1},
    {"fieldname": "project", "fieldtype": "Link", "options": "Project", "label": "Project"},
    {"fieldname": "period_start", "fieldtype": "Date", "label": "Period Start", "reqd": 1},
    {"fieldname": "period_end", "fieldtype": "Date", "label": "Period End", "reqd": 1},
    {"fieldname": "target_value", "fieldtype": "Float", "label": "Target Value", "reqd": 1},
    {"fieldname": "current_value", "fieldtype": "Float", "label": "Current Value", "default": "0", "reqd": 1},
