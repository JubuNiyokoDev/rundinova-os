{
  "doctype": "DocType",
  "name": "RundiNova Document",
  "module": "RundiNova Tech",
  "custom": 0,
  "title_field": "document_title",
  "fields": [
    {"fieldname": "document_title", "fieldtype": "Data", "label": "Document Title", "reqd": 1, "in_list_view": 1},
    {"fieldname": "document_type", "fieldtype": "Select", "label": "Type", "options": "Contract\nInvoice\nReceipt\nReport\nTemplate\nImage\nVideo\nMeeting Minutes\nPolicy\nOther", "reqd": 1, "in_list_view": 1},
    {"fieldname": "file", "fieldtype": "Attach", "label": "File", "reqd": 1},
    {"fieldname": "project", "fieldtype": "Link", "options": "Project", "label": "Project"},
    {"fieldname": "decision", "fieldtype": "Link", "options": "RundiNova Decision", "label": "Decision"},
    {"fieldname": "expense", "fieldtype": "Link", "options": "RundiNova Expense", "label": "Expense"},
    {"fieldname": "owner", "fieldtype": "Link", "options": "User", "label": "Owner", "reqd": 1},
    {"fieldname": "confidentiality", "fieldtype": "Select", "label": "Confidentiality", "options": "Internal\nConfidential\nRestricted", "default": "Internal", "reqd": 1, "in_list_view": 1},
    {"fieldname": "document_date", "fieldtype": "Date", "label": "Document Date"},
    {"fieldname": "review_date", "fieldtype": "Date", "label": "Review Date"},
