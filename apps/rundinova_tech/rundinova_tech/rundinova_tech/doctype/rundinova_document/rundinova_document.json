    {"role": "RundiNova Finance Manager", "read": 1, "write": 1, "create": 1},
    {"role": "RundiNova Project Lead", "read": 1, "write": 1, "create": 1},
    {"role": "RundiNova Communications", "read": 1, "write": 1, "create": 1},
    {"role": "RundiNova Team Member", "read": 1, "create": 1}
