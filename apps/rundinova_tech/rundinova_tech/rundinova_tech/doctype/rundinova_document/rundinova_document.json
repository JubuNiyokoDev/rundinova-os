{
  "doctype": "DocType",
  "name": "RundiNova Document",
  "module": "RundiNova Tech",
  "custom": 0,
  "title_field": "document_title",
  "show_title_field_in_link": 1,
  "fields": [
    {
      "fieldname": "document_title",
      "fieldtype": "Data",
      "label": "Titre du document",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_type",
      "fieldtype": "Select",
      "label": "Type de document",
      "options": "Contrat\nFacture\nReçu\nRapport\nModèle\nProcès-verbal\nPolitique\nDocument juridique\nSpécification technique\nLivrable\nImage\nVidéo\nAutre",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_folder",
      "fieldtype": "Link",
      "options": "RundiNova Document Folder",
      "label": "Dossier documentaire",
      "in_list_view": 1
    },
    { "fieldname": "file", "fieldtype": "Attach", "label": "Fichier", "reqd": 1 },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "options": "Project",
      "label": "Projet"
    },
    {
      "fieldname": "decision",
      "fieldtype": "Link",
      "options": "RundiNova Decision",
      "label": "Décision"
    },
    {
      "fieldname": "expense",
      "fieldtype": "Link",
      "options": "RundiNova Expense",
      "label": "Dépense"
    },
    {
      "fieldname": "document_owner",
      "fieldtype": "Link",
      "options": "User",
      "label": "Responsable",
      "reqd": 1
    },
    {
      "fieldname": "access_scope",
      "fieldtype": "Select",
      "label": "Portée d’accès",
      "options": "Standard\nExecutive Council",
      "default": "Standard",
      "reqd": 1
    },
    {
      "fieldname": "confidentiality",
      "fieldtype": "Select",
      "label": "Confidentialité",
      "options": "Internal\nConfidential\nRestricted",
      "default": "Internal",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_date",
      "fieldtype": "Date",
      "label": "Date du document"
    },
    { "fieldname": "review_date", "fieldtype": "Date", "label": "Date de révision" },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Statut",
      "options": "Draft\nActive\nArchived\nExpired",
      "default": "Active",
      "reqd": 1,
      "in_list_view": 1
    },
    { "fieldname": "notes", "fieldtype": "Small Text", "label": "Notes / contexte" }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    { "role": "RundiNova Director", "read": 1, "write": 1, "create": 1 },
    { "role": "RundiNova Finance Manager", "read": 1, "write": 1, "create": 1 },
    { "role": "RundiNova Project Lead", "read": 1, "write": 1, "create": 1 },
    { "role": "RundiNova Communications", "read": 1, "write": 1, "create": 1 },
    { "role": "RundiNova Team Member", "read": 1, "create": 1 }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
